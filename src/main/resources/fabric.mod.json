{
	"schemaVersion": 1,
	"id": "soundboard",
	"version": "${version}",
	"name": "Simple Voice Chat Soundboard",
	"description": "Client-side soundboard for Simple Voice Chat to play custom sounds.",
	"authors": [
		"Twyco"
	],
	"contact": {
		"sources": "https://github.com/Twyco/soundboard",
		"issues": "https://github.com/Twyco/soundboard/issues"
	},
	"license": "MIT",
	"icon": "assets/soundboard/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"de.twyco.soundboard.Soundboard"
		],
		"modmenu": [
			"de.twyco.soundboard.modImplementations.modMenu.ModMenuApi"
		],
		"voicechat": [
			"de.twyco.soundboard.modImplementations.simpleVoicechatApi.SimpleVoicechatApi"
		]
	},
	"mixins": [
		"soundboard.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "26.2",
		"fabric-api": "*",
		"voicechat_api": ">=2.6.0"
	},
	"suggests": {
		"modmenu": "*"
	}
}
